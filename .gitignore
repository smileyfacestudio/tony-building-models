# Local/private work is excluded as a precaution, not as a security boundary.
/private/
/local/
/media/
/outputs/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.DS_Store
Thumbs.db
node_modules/
dist/
